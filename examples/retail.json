    {"name":"FactTargets","description":"Sales targets by month","columns":[{"name":"TargetKey","type":"int64"},{"name":"DateKey","type":"int64"},{"name":"RegionKey","type":"int64"},{"name":"TargetAmount","type":"decimal"}],"measures":[{"name":"Total Target","expression":"SUM(FactTargets[TargetAmount])"}]}],
  "relationships":[
